# mac-bench environment schema — https://varlock.dev
#
# The shared bearer token lives in a 1Password environment and loads
# through the 1Password plugin. Run the entry points through varlock:
#   bun run helper        (on the Mac)
#   bun run mac-bench …   (on the VM)
# Tests read no environment: everything below the entry points takes its
# config as arguments.
#
# @defaultRequired=false @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=false)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# ----------

# 1Password service-account token with read access to mac-bench's
# environment. Set in .env.local (gitignored); never commit it.
# @required @type=opServiceAccountToken
OP_TOKEN=

# The 1Password environment holding mac-bench's secrets. Set in .env.local.
# @required @sensitive=false
OP_ENV_ID=

# Shared bearer token: the VM sends it, the helper on the Mac checks it.
# @required
MAC_BENCH_TOKEN=

# Where the VM reaches the helper (the Mac's tailnet name and port).
# @sensitive=false
MAC_BENCH_URL=http://kevins-macbook-pro-2021:7420

# The port the helper listens on, on the Mac's tailnet address.
# @sensitive=false @type=port
MAC_BENCH_PORT=7420
